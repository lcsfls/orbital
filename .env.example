# Copy to .env and adjust. docker compose reads it automatically.

# Host port for the web UI.
PORT=8080

# Time zone for daily streaks and snapshots.
TZ=Europe/Berlin

# Container user (uid:gid). On Linux set this to your own user so ./data stays writable,
# e.g. 1000:1000. Docker Desktop on Windows and macOS does not need it.
ORBITAL_UID_GID=1000:1000

# Accounts. The first person to open Orbital creates the admin account.
# If the instance is reachable by others before you set it up, set a SETUP_TOKEN:
# the setup form then asks for it.
SETUP_TOKEN=
# Session cookie "Secure" flag: auto (when the request came over HTTPS), true or false.
COOKIE_SECURE=auto
# Behind a reverse proxy (Traefik, nginx): number of trusted proxy hops, e.g. 1.
TRUST_PROXY=

# Home: trophy room with a 3D living room (click Orbit or your level). Set false to hide it.
HOME_ENABLED=true

# Local AI via an OpenAI-compatible endpoint (Ollama, LM Studio, llama.cpp server, vLLM).
# Off by default. Nothing is ever sent to a cloud URL unless you put one here yourself.
# With the bundled Ollama container (docker compose --profile ai up -d) use:
#   AI_ENABLED=true
#   AI_BASE_URL=http://ollama:11434/v1
#   AI_MODEL=llama3.2:3b
AI_ENABLED=false
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=llama3.1:8b
AI_API_KEY=
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=800
