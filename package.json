{
  "name": "orbital",
  "version": "1.0.0",
  "description": "Orbital – an ADHD-friendly idea and project tracker with Eisenhower, Core/Context and economics evaluation.",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "backend/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:unit": "node --test tests/rules.test.js tests/gamification.test.js",
    "test:api": "node --test tests/api.test.js",
    "test:smoke": "node --test tests/smoke.test.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "5.1.0",
    "three": "0.186.1"
  }
}
